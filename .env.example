# Copy to .env (git-ignored). Every value is optional; defaults target Concordium testnet.

# Network: testnet (default) | mainnet
VC_NETWORK=testnet

# Hosted Concordium Agent Registry MCP server + indexer
VC_REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com/mcp
VC_REGISTRY_INDEXER_URL=https://agent-registry-indexer.concordium.com

# x402 facilitator that sponsors fees on Concordium testnet
VC_FACILITATOR_URL=https://concordium-facilitator.onrender.com

# Only for `pnpm pay` (real testnet payments). NEVER commit these.
VC_BUYER_ACCOUNT=
VC_BUYER_KEY=

# Where the CLI writes its hash-chained audit log
VC_AUDIT_PATH=audit/payments.jsonl
