{
  "name": "@verified-counterparty/core",
  "version": "0.1.0",
  "description": "Policy engine, Concordium badge verifier, x402 payment guard and tamper-evident audit log for agent-to-agent payments.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/payment/x402-concordium.d.ts",
      "import": "./dist/payment/x402-concordium.js"
    },
    "./node": {
      "types": "./dist/audit/jsonl-sink.d.ts",
      "import": "./dist/audit/jsonl-sink.js"
    },
    "./audit": {
      "types": "./dist/audit/audit-log.d.ts",
      "import": "./dist/audit/audit-log.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "LIVE=1 vitest run test/live",
    "demo": "tsx src/cli/demo.ts"
  },
  "dependencies": {
    "@concordium/web-sdk": "^12.0.2",
    "@x402/concordium": "^2.31.0",
    "@x402/core": "^2.31.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
